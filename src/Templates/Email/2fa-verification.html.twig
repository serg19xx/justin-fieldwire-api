{% extends "base-layout.html.twig" %}

{% block content %}
    <div class="email-title">
        Two-Factor Authentication
    </div>
    
    <div class="email-greeting">
        Hello <strong>{{ userName }}</strong>,
    </div>
    
    <p style="color: #4b5563; margin-bottom: 25px;">
        We received a request to verify your identity. Please use the verification code below to complete your login.
    </p>
    
    <div class="code-box">
        <div class="code-label">Your Verification Code</div>
        <div class="code-value">{{ code }}</div>
    </div>
    
    <div class="info-box">
        <div class="info-box-title">How to use this code:</div>
        <ol style="margin: 10px 0 0 20px; color: #64748b;">
            <li style="margin: 8px 0;">Return to the login page</li>
            <li style="margin: 8px 0;">Enter the 6-digit code shown above</li>
            <li style="margin: 8px 0;">Complete your sign-in</li>
        </ol>
    </div>
    
    <div class="warning-box">
        <div class="warning-icon">⏰</div>
        <strong>This code expires in 1 minute</strong><br>
        <span style="font-size: 13px; color: #78350f;">For your security, this code will expire shortly. Please use it immediately.</span>
    </div>
    
    <div class="divider"></div>
    
    <div class="security-notice">
        <div class="security-notice-title">Security Notice</div>
        <p>If you didn't request this verification code, please ignore this email and ensure your account is secure. Someone may have tried to access your account.</p>
        <p style="margin-top: 10px;"><strong>Never share this code with anyone.</strong> FieldWire staff will never ask for your verification code.</p>
    </div>
{% endblock %}

