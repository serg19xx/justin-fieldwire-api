{% extends "base-layout.html.twig" %}

{% block content %}
    <div class="email-title">
        Password Reset Request
    </div>
    
    <div class="email-greeting">
        Hello <strong>{{ userName }}</strong>,
    </div>
    
    <p style="color: #4b5563; margin-bottom: 25px;">
        We received a request to reset your password. Click the button below to create a new password for your account.
    </p>
    
    <div class="button-container">
        <a href="{{ resetLink }}" class="button">Reset Your Password</a>
    </div>
    
    <p style="text-align: center; color: #6b7280; font-size: 14px; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:
    </p>
    <p style="word-break: break-all; background-color: #f3f4f6; padding: 12px; border-radius: 6px; font-size: 12px; font-family: monospace; color: #374151; text-align: center;">
        {{ resetLink }}
    </p>
    
    <div class="divider"></div>
    
    <div class="warning-box">
        <div class="warning-icon">⏰</div>
        <strong>This link expires in 10 minutes</strong><br>
        <span style="font-size: 13px; color: #78350f;">For your security, this reset link will expire shortly.</span>
    </div>
    
    <div class="steps-box">
        <div class="steps-title">How to Reset Your Password:</div>
        <ol>
            <li>Click the <strong>"Reset Your Password"</strong> button above</li>
            <li>You'll be redirected to a secure page</li>
            <li>Enter your new password</li>
            <li>Confirm your new password</li>
            <li>Log in with your new credentials</li>
        </ol>
    </div>
    
    <div class="divider"></div>
    
    <div class="security-notice">
        <div class="security-notice-title">Security Notice</div>
        <p>If you didn't request this password reset, please ignore this email. Your account remains secure, and no changes have been made.</p>
        <p style="margin-top: 10px;">If you're concerned about your account security, please contact our support team immediately.</p>
    </div>
{% endblock %}

