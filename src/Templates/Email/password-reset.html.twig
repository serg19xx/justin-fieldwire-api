{% extends "transactional-layout.html.twig" %}

{% block content %}
    <p style="margin:0 0 16px;font-size:16px;">Hello {{ userName }},</p>

    <p style="margin:0 0 20px;font-size:15px;color:#3f3f46;">
        Use this code to reset your FieldWire password. It expires in 10 minutes.
    </p>

    <p style="margin:0 0 24px;font-size:32px;font-weight:700;letter-spacing:6px;color:#18181b;">
        {{ code }}
    </p>

    <p style="margin:0 0 12px;">
        <a href="{{ resetLink }}" style="display:inline-block;background:#1d4ed8;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;font-size:15px;font-weight:600;">
            Reset password
        </a>
    </p>

    <p style="margin:20px 0 0;font-size:13px;color:#52525b;word-break:break-all;">
        Or open: {{ resetLink }}
    </p>

    <p style="margin:24px 0 0;font-size:13px;color:#71717a;">
        If you did not request a password reset, you can ignore this email. Your password will stay the same.
    </p>
{% endblock %}
