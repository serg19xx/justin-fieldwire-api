        <tr>
            <td style="padding:24px 28px 8px;font-size:18px;font-weight:700;color:#1d4ed8;">
                FieldWire
            </td>
        </tr>
        <tr>
            <td style="padding:8px 28px 24px;">
                {% block content %}{% endblock %}
            </td>
        </tr>
        <tr>
            <td style="padding:16px 28px 24px;border-top:1px solid #e4e4e7;font-size:12px;color:#71717a;">
                Medical Contractor · <a href="https://fieldwire.medicalcontractor.ca" style="color:#1d4ed8;">fieldwire.medicalcontractor.ca</a><br>
