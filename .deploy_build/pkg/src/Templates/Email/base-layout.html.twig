<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ emailTitle|default('FieldWire') }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333333;
            background-color: #f5f5f5;
            padding: 20px;
        }
        .email-wrapper {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        /* Header */
        .email-header {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            padding: 40px 30px;
            text-align: center;
        }
        .email-header .logo {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }
        .email-header .tagline {
            font-size: 14px;
            opacity: 0.9;
            font-weight: 400;
        }
        
        /* Content */
        .email-content {
            padding: 40px 30px;
        }
        .email-title {
            font-size: 24px;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 20px;
            text-align: center;
        }
        .email-greeting {
            font-size: 16px;
            color: #4b5563;
            margin-bottom: 25px;
        }
        
        /* Button */
        .button-container {
            text-align: center;
            margin: 35px 0;
        }
        .button {
            display: inline-block;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff !important;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            transition: transform 0.2s;
        }
        .button:hover {
            transform: translateY(-2px);
        }
        
        /* Info Box */
        .info-box {
            background-color: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 25px;
            margin: 25px 0;
        }
        .info-box-title {
            font-size: 16px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        .info-box-title::before {
            content: "ℹ️";
            margin-right: 8px;
            font-size: 18px;
        }
        
        /* Code Box */
        .code-box {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border: 3px solid #0284c7;
            border-radius: 12px;
            padding: 30px;
            margin: 30px 0;
            text-align: center;
        }
        .code-label {
            font-size: 14px;
            color: #0369a1;
            font-weight: 600;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .code-value {
            font-size: 36px;
            font-weight: 700;
            color: #0c4a6e;
            letter-spacing: 8px;
            font-family: 'Monaco', 'Courier New', monospace;
        }
        
        /* Warning Box */
        .warning-box {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border: 2px solid #f59e0b;
            border-radius: 10px;
            padding: 20px;
            margin: 25px 0;
            text-align: center;
        }
        .warning-box strong {
            color: #92400e;
            font-size: 15px;
        }
        .warning-icon {
            font-size: 24px;
            margin-bottom: 8px;
        }
        
        /* Steps */
        .steps-box {
            background-color: #f0fdf4;
            border-left: 4px solid #10b981;
            border-radius: 8px;
            padding: 25px;
            margin: 25px 0;
        }
        .steps-title {
            font-size: 16px;
            font-weight: 600;
            color: #065f46;
            margin-bottom: 15px;
        }
        .steps-box ol {
            padding-left: 20px;
            color: #047857;
        }
        .steps-box li {
            margin: 10px 0;
            line-height: 1.5;
        }
        
        /* Security Notice */
        .security-notice {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            border: 2px solid #ef4444;
            border-radius: 10px;
            padding: 20px;
            margin: 25px 0;
        }
        .security-notice-title {
            font-weight: 600;
            color: #991b1b;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }
        .security-notice-title::before {
            content: "🔒";
            margin-right: 8px;
            font-size: 18px;
        }
        .security-notice p {
            color: #7f1d1d;
            margin: 5px 0;
        }
        
        /* Footer */
        .email-footer {
            background-color: #f9fafb;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }
        .email-footer-brand {
            font-size: 16px;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 5px;
        }
        .email-footer-tagline {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 20px;
        }
        .email-footer-links {
            margin: 20px 0;
        }
        .email-footer-links a {
            color: #2563eb;
            text-decoration: none;
            margin: 0 12px;
            font-size: 14px;
            font-weight: 500;
        }
        .email-footer-links a:hover {
            text-decoration: underline;
        }
        .email-footer-legal {
            font-size: 12px;
            color: #9ca3af;
            margin-top: 20px;
            line-height: 1.5;
        }
        
        /* Divider */
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
            margin: 30px 0;
        }
        
        /* Responsive */
        @media only screen and (max-width: 600px) {
            body {
                padding: 10px;
            }
            .email-content {
                padding: 30px 20px;
            }
            .email-header {
                padding: 30px 20px;
            }
            .code-value {
                font-size: 28px;
                letter-spacing: 4px;
            }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <!-- Header -->
        <div class="email-header">
            <div class="logo">FieldWire</div>
            <div class="tagline">Professional Construction Management</div>
        </div>
        
        <!-- Content -->
        <div class="email-content">
            {% block content %}{% endblock %}
        </div>
        
        <!-- Footer -->
        <div class="email-footer">
            <div class="email-footer-brand">FieldWire</div>
            <div class="email-footer-tagline">Streamlining Construction Projects</div>
            
            <div class="email-footer-links">
                <a href="https://medicalcontractor.ca">Medical Contractor</a> |
                <a href="https://fieldwire.medicalcontractor.ca">FieldWire Platform</a> |
                <a href="mailto:support@medicalcontractor.ca">Support</a>
            </div>
            
            <div class="divider"></div>
            
            <div class="email-footer-legal">
                © {{ "now"|date("Y") }} FieldWire. All rights reserved.<br>
                This email was sent from an automated system. Please do not reply directly to this email.
            </div>
        </div>
    </div>
</body>
</html>

